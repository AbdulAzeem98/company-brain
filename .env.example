# Company Brain Configuration (Nexora Technologies)

APP_NAME="Company Brain — Nexora Technologies"
APP_ENV=development

# Database and Ingestion Paths
DATABASE_PATH=data/company_brain.db
KNOWLEDGE_DIR=data/synthetic_company

# FastAPI Server
API_HOST=127.0.0.1
API_PORT=8000

# LLM Provider Configuration
# Options: "auto" (uses Gemini if key present, else retrieval_only), "gemini", "retrieval_only"
LLM_PROVIDER=auto

# Optional Google Gemini API Key
# If omitted or left empty, the application operates deterministically in Grounded Retrieval-Only Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Default Search & Security Parameters
DEFAULT_ROLE=employee
DEFAULT_SEARCH_LIMIT=5
MAX_RETRIEVAL_CHUNKS=5
